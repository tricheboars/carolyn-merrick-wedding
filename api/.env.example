# Copy to .env (never commit .env). Fill Twilio values once the toll-free number is live.
PORT=3000

# REQUIRED. Admin endpoints (/api/admin/*) refuse EVERY request when this is unset —
# they fail closed on purpose. Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# Bind address. Leave as loopback: nginx proxies from 127.0.0.1 on the same container,
# and 0.0.0.0 would expose the unauthenticated POST endpoints to the LAN.
BIND_HOST=127.0.0.1

# The couple's sign-in at /admin/ (Carolyn + Merrick). BOTH are required for it to
# work; with either missing the page says sign-in is not set up, and the token path
# above keeps working. SESSION_SECRET signs the 30-day cookie; rotate it to sign
# everyone out. Generate with:  openssl rand -hex 32
SESSION_SECRET=
# Four or five plain words, in double quotes (systemd and dotenv both strip them;
# an unquoted multi-word value breaks `source .env`). Case, spacing and
# punctuation are ignored when it is typed in.
ADMIN_PASSPHRASE=""

# Twilio (verified toll-free number) — see docs/05-sms-cost.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
