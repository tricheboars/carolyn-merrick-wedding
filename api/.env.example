# Copy to .env (never commit .env). Fill Twilio values once the toll-free number is live.
PORT=3000

# REQUIRED. Admin endpoints (/api/admin/*) refuse EVERY request when this is unset —
# they fail closed on purpose. Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# Bind address. Leave as loopback: nginx proxies from 127.0.0.1 on the same container,
# and 0.0.0.0 would expose the unauthenticated POST endpoints to the LAN.
BIND_HOST=127.0.0.1
SESSION_SECRET=change-me-to-a-long-random-string

# Twilio (verified toll-free number) — see docs/05-sms-cost.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
