---
layout: layouts/base.njk
title: Registry
permalink: /registry/
icons: true          # the only page using the Tabler icon webfont
description: "No gift registry, just a house fund toward our first home together. Venmo, Zelle, or by mail."
---
<section class="section section--scene section--scene-warm" style="--scene:var(--hero-photo)">
  <div class="wrap center stack">
    <span class="label eyebrow">With gratitude</span>
    <h1>Registry</h1>
    <p class="lead">Toward our first home together.</p>
  </div>
</section>

<section class="section section--cream">
  <div class="wrap" style="max-width:760px">
    <p class="center" style="font-size:1.15rem">{{ site.registry.intro }}</p>

    <div class="methods">
      {% for m in site.registry.methods %}
      <div class="method">
        <i class="ti {{ m.icon }}" aria-hidden="true"></i>
        <div><b>{{ m.label }}</b><span>{{ m.handle }}</span></div>
      </div>
      {% endfor %}
    </div>

    <div class="divider" style="margin-top:32px"><img src="/assets/svg/poppy-divider.svg" alt="" width="110" height="59"></div>

    {#- The thank-you must only appear if the note actually saved. The old version
        swallowed every failure and said "Thank you so much!" regardless, so a guest
        could believe the couple had been told when nothing was stored. -#}
    <div class="card" x-data="{ sent:false, busy:false, error:'',
      async submit(e){ if(this.busy) return; this.busy=true; this.error='';
        const fd=Object.fromEntries(new FormData(e.target).entries());
        try{ const r=await fetch((window.CM_API||'')+'/api/registry/ack',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(fd)});
          if(r.ok){ this.sent=true; }
          else if(r.status===429){ this.error='That went through a lot of times just now. Please wait a minute and try again.'; }
          else{ this.error='Sorry, that did not save. Please try again in a minute.'; } }
        catch(_){ this.error='We couldn\'t reach the server just now. Please try again in a minute.'; }
        finally{ this.busy=false; } } }">
      <h3>{{ site.registry.note }}</h3>
      <form class="form" @submit.prevent="submit($event)" x-show="!sent">
        <div class="field">
          <label for="r-name">Your name</label>
          <input id="r-name" name="name" type="text" maxlength="200" placeholder="Jane &amp; John Smith" required>
        </div>
        <div class="field">
          <label for="r-msg">A note (optional)</label>
          <textarea id="r-msg" name="note" rows="3" maxlength="1000" placeholder="So we can thank you properly"></textarea>
        </div>
        <p x-show="error" x-cloak class="note" style="color:var(--brick)" role="alert" x-text="error"></p>
        <button class="btn btn--ink" type="submit" x-bind:disabled="busy" x-text="busy ? 'Sending…' : 'Let them know'">Let them know</button>
      </form>
      <p x-show="sent" x-cloak class="note">Thank you so much! We'll be in touch.</p>
    </div>
  </div>
</section>
